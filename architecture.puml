@startuml
title Агент для учебных Telegram-чатов
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam componentStyle rectangle

actor "Учебные чаты" as chats
component "Telegram Bot API\nновые и изменённые сообщения" as telegram
component "Оркестратор\nфильтр, проверка, цикл" as agent
component "Локальная LLM\nQwen3 4B Instruct" as llm
component "MCP-клиент" as client
component "MCP-сервер\nинструменты" as server
database "SQLite\nсообщения и дедлайны" as db
database "sqlite-vec\nвекторный индекс" as vec
component "Ollama embeddings\nnomic-embed-text" as emb
actor "Топики по предметам\nи список дедлайнов" as output

chats --> telegram
telegram --> agent
agent --> client : поиск похожих заданий
client --> server : tools/call
server --> emb : эмбеддинг сообщения
server --> vec : top-k
server --> db : детали кандидатов
client --> agent : найденный контекст
agent --> llm : сообщение + кандидаты
llm --> agent : создать / изменить / отменить / игнорировать
agent --> client : выбранные действия
server --> db : сохранить актуальное состояние
server --> telegram : переслать и обновить сводку
telegram --> output
@enduml
